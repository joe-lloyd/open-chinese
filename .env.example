# SERVER-ONLY. Set these as Netlify environment variables — never in the repo,
# never in a .env file that gets committed, and never with a VITE_ prefix.
#
# A VITE_ prefix would inline the value into the browser bundle. None of the
# values below may ever be prefixed that way. The public, browser-safe variables
# live in client/.env.example.
#
# Stripe is the launch provider. Keep VITE_PAYMENTS_ENABLED=false until all
# test/live resources pass docs/payment-runbook.md.

# ── Which provider is live ──
# One of: stripe | coinbase-commerce
# Unset = payments not configured.
#
# Launch with `stripe`. The dated comparison, tax distinction, and provider
# review triggers are in docs/payment-provider-decision.md.
PAYMENT_PROVIDER=stripe

# Absolute origin used to build checkout return URLs, e.g. https://openchinese.app
# Netlify sets URL automatically in production; set this for local dev.
PUBLIC_SITE_URL=

# ── Firebase Admin ──
# A service account JSON key, either raw or base64-encoded.
#
# Create a DEDICATED service account with the "Cloud Datastore User" role only —
# not Owner, not Editor. This key is the one credential that can write
# entitlements, so scope it tightly and rotate it independently of everything
# else.
FIREBASE_SERVICE_ACCOUNT=

# ── Stripe (launch provider) ──
STRIPE_SECRET_KEY=
# From the webhook endpoint's signing secret (whsec_...). Required — the webhook
# handler rejects every request when this is unset.
STRIPE_WEBHOOK_SECRET=
# Price IDs, created in the Stripe dashboard. One per catalogue SKU.
#
# Both Pro intervals are offered and need distinct recurring Price IDs. Packs
# only need Price IDs if they are added to OFFERED_SKUS. Before enabling
# payments, verify each remote Price amount, currency and interval against
# packages/pricing/src/index.js.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_HSK_1=
STRIPE_PRICE_HSK_2=
STRIPE_PRICE_HSK_3=
STRIPE_PRICE_HSK_4=

# ── Coinbase Commerce (crypto, optional) ──
# Optional alternative adapter, selected with PAYMENT_PROVIDER=coinbase-commerce.
# It is not active alongside Stripe. Yearly Pro is prepaid and non-renewing;
# monthly Pro is unsupported.
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
# Decimal euro amounts, e.g. 25.00
CRYPTO_PRICE_PRO_YEARLY=
CRYPTO_PRICE_HSK_1=
CRYPTO_PRICE_HSK_2=
CRYPTO_PRICE_HSK_3=
CRYPTO_PRICE_HSK_4=

# ── Webhook endpoint to register with the provider ──
# https://<your-site>/.netlify/functions/webhook
#
# Stripe events to subscribe to:
#   checkout.session.completed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
#
# Coinbase Commerce: charge:confirmed
