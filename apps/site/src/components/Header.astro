---
import { SITE } from '../../site.config'

const path = Astro.url.pathname
const links = [
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/faq', label: 'FAQ' },
]
// Trailing slashes vary between dev and the built output; compare without one.
const here = (href: string) => path.replace(/\/$/, '') === href
---

<header class="border-b border-border">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4"
    aria-label="Main"
  >
    <a href="/" class="flex items-center gap-2 font-semibold text-text-primary">
      <span aria-hidden="true" class="text-xl leading-none text-accent">中</span>
      {SITE.name}
    </a>

    <ul class="flex items-center gap-1 sm:gap-2">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={here(href) ? 'page' : undefined}
              class:list={[
                'rounded-lg px-2.5 py-1.5 text-sm transition-colors sm:px-3',
                here(href)
                  ? 'text-text-primary font-medium'
                  : 'text-text-muted hover:text-text-primary',
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
      <!-- Two ways in, on purpose: returning users look for "Sign in", new ones
           respond to the offer. Both land on /app, which shows the login page
           when signed out and the dashboard when not. -->
      <li class="hidden sm:block">
        <a
          href={SITE.appPath}
          class="rounded-lg px-3 py-1.5 text-sm text-text-muted transition-colors hover:text-text-primary"
        >
          Sign in
        </a>
      </li>
      <li>
        <a
          href={SITE.appPath}
          class="ml-1 rounded-lg bg-accent-solid px-3 py-1.5 text-sm font-medium text-on-accent transition-opacity hover:opacity-90 sm:px-4"
        >
          Start free
        </a>
      </li>
    </ul>
  </nav>
</header>
