---
import Base from '../layouts/Base.astro'
---

<Base
  title="Page not found"
  description="That page does not exist."
  path="/404"
>
  <section class="mx-auto max-w-xl px-5 py-24 text-center sm:py-32">
    <p aria-hidden="true" class="text-6xl font-semibold text-accent">丢</p>
    <h1 class="mt-6 text-3xl font-bold">Page not found</h1>
    <p class="mt-3 text-pretty text-text-muted">
      That link has gone missing. The character above means “lost”, which is at least on theme.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-xl bg-accent-solid px-6 py-3 font-medium text-on-accent transition-opacity hover:opacity-90"
    >
      Back home
    </a>
  </section>
</Base>
