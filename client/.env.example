# EVERYTHING IN THIS FILE IS PUBLIC.
#
# Vite inlines every VITE_* variable into the JavaScript bundle it ships to the
# browser. Anyone can read them with view-source. Never put a payment provider
# secret key, a webhook signing secret or a service account credential here —
# those belong in the Netlify environment variables documented in the root
# .env.example, which the browser never sees.

# Firebase project config (from Project Settings → Your apps → web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Restrict sign-in to a single Google account (leave blank to allow any)
VITE_ALLOWED_EMAIL=you@gmail.com

# Expose pricing, paywalls and content gating. Anything other than "true" opens
# every gate and hides the pricing page — this is the monetization kill switch,
# and unsetting it needs no data migration.
VITE_PAYMENTS_ENABLED=false
