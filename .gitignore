# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnpm-store/

# build output — every app's, at any depth. apps/app/.gitignore covers its own
# from the Vite template; apps/site had nothing, and `apps/site/dist` also
# receives the assembled app build, so it must never be committed.
dist/
# Astro's generated types
.astro/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
*/.env

# sqlite databases (words.db is built — don't commit)
*.db

# reader runtime assets (built from content/readers — don't commit)
apps/app/public/data/readers/

# firebase cli
firebase-debug.log
firestore-debug.log
.firebaserc

# claude code
.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch output from scripts/check-functions-bundle.mjs
tmp/

# Firebase Admin key used by scripts/entitlement.mjs. This credential can write
# entitlements — never commit it.
service-account.json
